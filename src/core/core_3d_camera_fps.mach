use std.runtime;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use raylib.ra;

val GRAVITY: f32 = 32.0;
val MAX_SPEED: f32 = 20.0;
val CROUCH_SPEED: f32 = 5.0;
val JUMP_FORCE: f32 = 12.0;
val MAX_ACCEL: f32 = 150.0;
val FRICTION: f32 = 0.86;
val AIR_DRAG: f32 = 0.98;
val CONTROL: f32 = 15.0;
val CROUCH_HEIGHT: f32 = 0.0;
val STAND_HEIGHT: f32 = 1.0;
val BOTTOM_HEIGHT: f32 = 0.5;

rec Body {
    position: ra.Vector3;
    velocity: ra.Vector3;
    dir: ra.Vector3;
    is_grounded: bool;
}

var sensitivity: ra.Vector2 = ra.Vector2{x: 0.001, y: 0.001};
var player: Body = Body{
    position: ra.Vector3{x: 0.0, y: 0.0, z: 0.0},
    velocity: ra.Vector3{x: 0.0, y: 0.0, z: 0.0},
    dir: ra.Vector3{x: 0.0, y: 0.0, z: 0.0},
    is_grounded: false,
};
var look_rotation: ra.Vector2 = ra.Vector2{x: 0.0, y: 0.0};
var head_timer: f32 = 0.0;
var walk_lerp: f32 = 0.0;
var head_lerp: f32 = STAND_HEIGHT;
var lean: ra.Vector2 = ra.Vector2{x: 0.0, y: 0.0};

fun clampf(value: f32, min_value: f32, max_value: f32) f32 {
    ret ra.clamp(value, min_value, max_value);
}

fun update_body(body: *Body, rot: f32, side: f32, forward: f32, jump_pressed: bool, crouch_hold: bool) {
    val input: ra.Vector2 = ra.Vector2{x: side, y: -forward};
    val delta: f32 = ra.get_frame_time();

    if (!body.is_grounded) {
        body.velocity.y = body.velocity.y - GRAVITY * delta;
    }

    if (body.is_grounded && jump_pressed) {
        body.velocity.y = JUMP_FORCE;
        body.is_grounded = false;
    }

    val front_rotation: ra.Vector2 = ra.vector2_rotate(ra.Vector2{x: 1.0, y: 0.0}, rot);
    val right_rotation: ra.Vector2 = ra.vector2_rotate(ra.Vector2{x: 1.0, y: 0.0}, -rot);
    val front: ra.Vector3 = ra.Vector3{x: front_rotation.y, y: 0.0, z: front_rotation.x};
    val right: ra.Vector3 = ra.Vector3{x: right_rotation.x, y: 0.0, z: right_rotation.y};
    val desired_dir: ra.Vector3 = ra.Vector3{
        x: input.x * right.x + input.y * front.x,
        y: 0.0,
        z: input.x * right.z + input.y * front.z,
    };
    body.dir = ra.vector3_lerp(body.dir, desired_dir, CONTROL * delta);

    var decel: f32 = AIR_DRAG;
    if (body.is_grounded) {
        decel = FRICTION;
    }

    var hvel: ra.Vector3 = ra.Vector3{
        x: body.velocity.x * decel,
        y: 0.0,
        z: body.velocity.z * decel,
    };
    val hvel_length: f32 = ra.vector3_length(hvel);
    if (hvel_length < MAX_SPEED * 0.01) {
        hvel = ra.Vector3{x: 0.0, y: 0.0, z: 0.0};
    }

    val speed: f32 = ra.vector3_dot_product(hvel, body.dir);
    var max_speed: f32 = MAX_SPEED;
    if (crouch_hold) {
        max_speed = CROUCH_SPEED;
    }
    val accel: f32 = clampf(max_speed - speed, 0.0, MAX_ACCEL * delta);
    hvel.x = hvel.x + body.dir.x * accel;
    hvel.z = hvel.z + body.dir.z * accel;

    body.velocity.x = hvel.x;
    body.velocity.z = hvel.z;
    body.position.x = body.position.x + body.velocity.x * delta;
    body.position.y = body.position.y + body.velocity.y * delta;
    body.position.z = body.position.z + body.velocity.z * delta;

    if (body.position.y <= 0.0) {
        body.position.y = 0.0;
        body.velocity.y = 0.0;
        body.is_grounded = true;
    }
}

fun update_camera_fps(camera: *ra.Camera3D) {
    val up: ra.Vector3 = ra.Vector3{x: 0.0, y: 1.0, z: 0.0};
    val target_offset: ra.Vector3 = ra.Vector3{x: 0.0, y: 0.0, z: -1.0};
    val yaw: ra.Vector3 = ra.vector3_rotate_by_axis_angle(target_offset, up, look_rotation.x);

    var max_angle_up: f32 = ra.vector3_angle(up, yaw);
    max_angle_up = max_angle_up - 0.001;
    if (-look_rotation.y > max_angle_up) {
        look_rotation.y = -max_angle_up;
    }

    var max_angle_down: f32 = ra.vector3_angle(ra.vector3_negate(up), yaw);
    max_angle_down = max_angle_down * -1.0;
    max_angle_down = max_angle_down + 0.001;
    if (-look_rotation.y < max_angle_down) {
        look_rotation.y = -max_angle_down;
    }

    val right: ra.Vector3 = ra.vector3_normalize(ra.vector3_cross_product(yaw, up));
    var pitch_angle: f32 = -look_rotation.y - lean.y;
    pitch_angle = clampf(pitch_angle, -ra.PI / 2.0 + 0.0001, ra.PI / 2.0 - 0.0001);
    val pitch: ra.Vector3 = ra.vector3_rotate_by_axis_angle(yaw, right, pitch_angle);

    val head_rotation: ra.Vector2 = ra.vector2_rotate(
        ra.Vector2{x: 1.0, y: 0.0},
        head_timer * ra.PI,
    );
    val head_sin: f32 = head_rotation.y;
    val head_cos: f32 = head_rotation.x;
    val step_rotation: f32 = 0.01;
    camera.up = ra.vector3_rotate_by_axis_angle(up, pitch, head_sin * step_rotation + lean.x);

    val bob_side: f32 = 0.1;
    val bob_up: f32 = 0.15;
    var bobbing: ra.Vector3 = ra.vector3_scale(right, head_sin * bob_side);
    var bob_height: f32 = head_cos * bob_up;
    if (bob_height < 0.0) {
        bob_height = -bob_height;
    }
    bobbing.y = bob_height;

    camera.position = ra.vector3_add(camera.position, ra.vector3_scale(bobbing, walk_lerp));
    camera.target = ra.vector3_add(camera.position, pitch);
}

fun draw_level() {
    val floor_extent: i32 = 25;
    val tile_size: f32 = 5.0;
    val tile_color_1: ra.Color = ra.Color{r: 150, g: 200, b: 200, a: 255};

    var y: i32 = -floor_extent;
    for (y < floor_extent) {
        fin { y = y + 1; }
        var x: i32 = -floor_extent;
        for (x < floor_extent) {
            fin { x = x + 1; }
            if (((y & 1) != 0) && ((x & 1) != 0)) {
                ra.draw_plane(
                    ra.Vector3{x: x::f32 * tile_size, y: 0.0, z: y::f32 * tile_size},
                    ra.Vector2{x: tile_size, y: tile_size},
                    tile_color_1,
                );
            }
            if (((y & 1) == 0) && ((x & 1) == 0)) {
                ra.draw_plane(
                    ra.Vector3{x: x::f32 * tile_size, y: 0.0, z: y::f32 * tile_size},
                    ra.Vector2{x: tile_size, y: tile_size},
                    ra.LIGHTGRAY,
                );
            }
        }
    }

    val tower_size: ra.Vector3 = ra.Vector3{x: 16.0, y: 32.0, z: 16.0};
    val tower_color: ra.Color = ra.Color{r: 150, g: 200, b: 200, a: 255};
    var tower_pos: ra.Vector3 = ra.Vector3{x: 16.0, y: 16.0, z: 16.0};

    ra.draw_cube_v(tower_pos, tower_size, tower_color);
    ra.draw_cube_wires_v(tower_pos, tower_size, ra.DARKBLUE);
    tower_pos.x = -tower_pos.x;
    ra.draw_cube_v(tower_pos, tower_size, tower_color);
    ra.draw_cube_wires_v(tower_pos, tower_size, ra.DARKBLUE);
    tower_pos.z = -tower_pos.z;
    ra.draw_cube_v(tower_pos, tower_size, tower_color);
    ra.draw_cube_wires_v(tower_pos, tower_size, ra.DARKBLUE);
    tower_pos.x = -tower_pos.x;
    ra.draw_cube_v(tower_pos, tower_size, tower_color);
    ra.draw_cube_wires_v(tower_pos, tower_size, ra.DARKBLUE);

    ra.draw_sphere(
        ra.Vector3{x: 300.0, y: 300.0, z: 0.0},
        100.0,
        ra.Color{r: 255, g: 0, b: 0, a: 255},
    );
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val screen_width: i32 = 800;
    val screen_height: i32 = 450;

    ra.init_window(screen_width, screen_height, "raylib [core] example - 3d camera fps");

    var camera: ra.Camera3D = ra.Camera3D{
        position: ra.Vector3{x: player.position.x, y: player.position.y + (BOTTOM_HEIGHT + head_lerp), z: player.position.z},
        target: ra.Vector3{x: 0.0, y: 0.0, z: 0.0},
        up: ra.Vector3{x: 0.0, y: 0.0, z: 0.0},
        fovy: 60.0,
        projection: ra.CAMERA_PERSPECTIVE,
    };

    update_camera_fps(?camera);
    ra.disable_cursor();
    ra.set_target_fps(60);

    for (!ra.window_should_close()) {
        val mouse_delta: ra.Vector2 = ra.get_mouse_delta();
        look_rotation.x = look_rotation.x - mouse_delta.x * sensitivity.x;
        look_rotation.y = look_rotation.y + mouse_delta.y * sensitivity.y;

        var side_way: f32 = 0.0;
        var forward: f32 = 0.0;
        if (ra.is_key_down(ra.KEY_D)) { side_way = side_way + 1.0; }
        if (ra.is_key_down(ra.KEY_A)) { side_way = side_way - 1.0; }
        if (ra.is_key_down(ra.KEY_W)) { forward = forward + 1.0; }
        if (ra.is_key_down(ra.KEY_S)) { forward = forward - 1.0; }

        val crouching: bool = ra.is_key_down(ra.KEY_LEFT_CONTROL);
        update_body(?player, look_rotation.x, side_way, forward, ra.is_key_pressed(ra.KEY_SPACE), crouching);

        val delta: f32 = ra.get_frame_time();
        var target_head_height: f32 = STAND_HEIGHT;
        if (crouching) { target_head_height = CROUCH_HEIGHT; }
        head_lerp = ra.lerp(head_lerp, target_head_height, 20.0 * delta);
        camera.position = ra.Vector3{
            x: player.position.x,
            y: player.position.y + (BOTTOM_HEIGHT + head_lerp),
            z: player.position.z,
        };

        if (player.is_grounded && ((forward != 0.0) || (side_way != 0.0))) {
            head_timer = head_timer + delta * 3.0;
            walk_lerp = ra.lerp(walk_lerp, 1.0, 10.0 * delta);
            camera.fovy = ra.lerp(camera.fovy, 55.0, 5.0 * delta);
        }
        if (!(player.is_grounded && ((forward != 0.0) || (side_way != 0.0)))) {
            walk_lerp = ra.lerp(walk_lerp, 0.0, 10.0 * delta);
            camera.fovy = ra.lerp(camera.fovy, 60.0, 5.0 * delta);
        }

        lean.x = ra.lerp(lean.x, side_way * 0.02, 10.0 * delta);
        lean.y = ra.lerp(lean.y, forward * 0.015, 10.0 * delta);
        update_camera_fps(?camera);

        ra.begin_drawing();
            ra.clear_background(ra.RAYWHITE);
            ra.begin_mode3d(camera);
            draw_level();
            ra.end_mode3d();

            ra.draw_rectangle(5, 5, 330, 75, ra.fade(ra.SKYBLUE, 0.5));
            ra.draw_rectangle_lines(5, 5, 330, 75, ra.BLUE);
            ra.draw_text("Camera controls:", 15, 15, 10, ra.BLACK);
            ra.draw_text("- Move keys: W, A, S, D, Space, Left-Ctrl", 15, 30, 10, ra.BLACK);
            ra.draw_text("- Look around: arrow keys or mouse", 15, 45, 10, ra.BLACK);

            val horizontal_velocity: ra.Vector2 = ra.Vector2{x: player.velocity.x, y: player.velocity.z};
            val velocity_length: f32 = ra.vector2_length(horizontal_velocity);
            ra.draw_text(ra.text_format("- Velocity Len: (%06.3f)", velocity_length::f64), 15, 60, 10, ra.BLACK);
            ra.logo(screen_width - 160, screen_height - 80, 1.0);

        ra.end_drawing();
    }

    ra.close_window();
    ret 0;
}
