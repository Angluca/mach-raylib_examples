use std.runtime;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.string.str;
use raylib.ra;

# entrypoint of the smooth pixelperfect example
#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    # initialization
    val screen_width: i32 = 800;
    val screen_height: i32 = 450;

    val virtual_screen_width: i32 = 160;
    val virtual_screen_height: i32 = 90;

    val virtual_ratio: f32 = screen_width::f32 / virtual_screen_width::f32;

    ra.init_window(screen_width, screen_height, "raylib [core] example - smooth pixelperfect");

    var world_space_camera: ra.Camera2D; # game world camera
    world_space_camera.zoom = 1.0;

    var screen_space_camera: ra.Camera2D; # smoothing camera
    screen_space_camera.zoom = 1.0;

    # load render texture to draw all our objects
    val target: ra.RenderTexture = ra.load_render_texture(virtual_screen_width, virtual_screen_height);

    val rec01: ra.Rectangle = ra.Rectangle{ x: 70.0, y: 35.0, width: 20.0, height: 20.0 };
    val rec02: ra.Rectangle = ra.Rectangle{ x: 90.0, y: 55.0, width: 30.0, height: 10.0 };
    val rec03: ra.Rectangle = ra.Rectangle{ x: 80.0, y: 65.0, width: 15.0, height: 25.0 };

    # the target's height is flipped (in the source rectangle), due to opengl reasons
    val source_rec: ra.Rectangle = ra.Rectangle{
        x: 0.0,
        y: 0.0,
        width: target.texture.width::f32,
        height: (-target.texture.height)::f32
    };

    var dest_rec: ra.Rectangle = ra.Rectangle{
        x: (screen_width::f32 - screen_width::f32 / 1.25) / 2.0,
        y: (screen_height::f32 - screen_height::f32 / 1.25) / 2.0,
        width: screen_width::f32 / 1.25,
        height: screen_height::f32 / 1.25
    };

    val origin: ra.Vector2 = ra.Vector2{ x: 0.0, y: 0.0 };

    var rotation: f32 = 0.0;
    var camera_x: f32 = 0.0;
    var camera_y: f32 = 0.0;

    var smooth_on: bool = true;
    var overscan: bool = false;

    ra.set_target_fps(60); # set our game to run at 60 frames-per-second

    # main game loop
    for (!ra.window_should_close()) { # detect window close button or esc key
        # update
        rotation = rotation + 60.0 * ra.get_frame_time(); # rotate the rectangles, 60 degrees per second

        # make the camera move to demonstrate the effect
        val t: f32 = ra.get_time()::f32;
        camera_x = (ra.sinf(t) * 50.0) - 10.0;
        camera_y = ra.cosf(t) * 30.0;

        # set the camera's target to the values computed above
        screen_space_camera.target = ra.Vector2{ x: camera_x, y: camera_y };

        # round world space coordinates, keep decimals into screen space coordinates
        world_space_camera.target.x = ra.truncf(screen_space_camera.target.x);
        screen_space_camera.target.x = screen_space_camera.target.x - world_space_camera.target.x;
        screen_space_camera.target.x = screen_space_camera.target.x * virtual_ratio;

        world_space_camera.target.y = ra.truncf(screen_space_camera.target.y);
        screen_space_camera.target.y = screen_space_camera.target.y - world_space_camera.target.y;
        screen_space_camera.target.y = screen_space_camera.target.y * virtual_ratio;

        if (ra.is_key_pressed(ra.KEY_S)) {
            smooth_on = !smooth_on;
        }
        if (ra.is_key_pressed(ra.KEY_O)) {
            overscan = !overscan;
        }

        if (overscan) {
            dest_rec = ra.Rectangle{
                x: -virtual_ratio,
                y: -virtual_ratio,
                width: screen_width::f32 + (virtual_ratio * 2.0),
                height: screen_height::f32 + (virtual_ratio * 2.0)
            };
        } or {
            dest_rec = ra.Rectangle{
                x: (screen_width::f32 - screen_width::f32 / 1.25) / 2.0,
                y: (screen_height::f32 - screen_height::f32 / 1.25) / 2.0,
                width: screen_width::f32 / 1.25,
                height: screen_height::f32 / 1.25
            };
        }

        # draw

        # draw the world scene into the virtual screen-size render texture
        ra.begin_texture_mode(target);
            ra.clear_background(ra.RAYWHITE);

            ra.begin_mode2d(world_space_camera);
                ra.draw_rectangle_pro(rec01, origin, rotation, ra.BLACK);
                ra.draw_rectangle_pro(rec02, origin, -rotation, ra.RED);
                ra.draw_rectangle_pro(rec03, origin, rotation + 45.0, ra.BLUE);
            ra.end_mode2d();
        ra.end_texture_mode();

        # draw the render texture to the screen, either smooth or raw
        ra.begin_drawing();
            ra.clear_background(ra.LIGHTGRAY);

            if (smooth_on) {
                ra.begin_mode2d(screen_space_camera);
                    ra.draw_texture_pro(target.texture, source_rec, dest_rec, origin, 0.0, ra.WHITE);
                ra.end_mode2d();
            } or {
                ra.draw_texture_pro(target.texture, source_rec, dest_rec, origin, 0.0, ra.WHITE);
            }

            var smooth_text: str = "OFF";
            if (smooth_on) {
                smooth_text = "ON";
            }
            var overscan_text: str = "OFF";
            if (overscan) {
                overscan_text = "ON";
            }

            ra.draw_text(ra.text_format("Screen resolution: %ix%i", screen_width, screen_height), 10, 10, 20, ra.DARKBLUE);
            ra.draw_text(ra.text_format("World resolution: %ix%i", virtual_screen_width, virtual_screen_height), 10, 40, 20, ra.DARKGREEN);
            ra.draw_text(ra.text_format("Smooth: %s", smooth_text), 10, screen_height - 60, 20, ra.RED);
            ra.draw_text(ra.text_format("Overscan: %s", overscan_text), 10, screen_height - 30, 20, ra.RED);
            ra.draw_fps(ra.get_screen_width() - 95, 10);
            ra.logo(screen_width - 160, screen_height - 80, 1.0);
        ra.end_drawing();
    }

    # de-initialization
    ra.unload_render_texture(target); # unload render texture
    ra.close_window(); # close window and opengl context

    ret 0;
}

