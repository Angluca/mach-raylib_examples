use std.runtime;
#use std.types.bool.bool;
#use std.types.bool.false;
use raylib.ra;

# entrypoint of the basic shapes example
#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    # initialization
    val screen_width: i32 = 800;
    val screen_height: i32 = 450;

    ra.init_window(screen_width, screen_height, "raylib [shapes] example - basic shapes");
    var rotation: f32 = 0.0;
    ra.set_target_fps(60); # set our game to run at 60 frames-per-second

    # main game loop
    for (!ra.window_should_close()) { # detect window close button or esc key
        # update
        rotation = rotation + 0.2;

        # draw
        ra.begin_drawing();
            ra.clear_background(ra.RAYWHITE);

            ra.draw_text("some basic shapes available on raylib", 20, 20, 20, ra.DARKGRAY);
            # circle shapes and lines
            ra.draw_circle(screen_width / 5, 120, 35::f32, ra.DARKBLUE);
            ra.draw_circle_gradient(ra.Vector2{ x: screen_width::f32 / 5.0, y: 220.0 }, 60::f32, ra.GREEN, ra.SKYBLUE);
            ra.draw_circle_lines(screen_width / 5, 340, 80::f32, ra.DARKBLUE);
            ra.draw_ellipse(screen_width / 5, 120, 25::f32, 20::f32, ra.YELLOW);
            ra.draw_ellipse_lines(screen_width / 5, 120, 30::f32, 25::f32, ra.YELLOW);

            # rectangle shapes and lines
            ra.draw_rectangle(screen_width / 4 * 2 - 60, 100, 120, 60, ra.RED);
            ra.draw_rectangle_gradient_h(screen_width / 4 * 2 - 90, 170, 180, 130, ra.MAROON, ra.GOLD);
            ra.draw_rectangle_lines(screen_width / 4 * 2 - 40, 320, 80, 60, ra.ORANGE); # note: uses quads internally, not lines

            # triangle shapes and lines
            ra.draw_triangle(
                ra.vector2(screen_width::f32 / 4.0 * 3.0, 80.0),
                ra.Vector2{ x: screen_width::f32 / 4.0 * 3.0 - 60.0, y: 150.0 },
                ra.Vector2{ x: screen_width::f32 / 4.0 * 3.0 + 60.0, y: 150.0 },
                ra.VIOLET
            );
            ra.draw_triangle_lines(
                ra.vector2(screen_width::f32 / 4.0 * 3.0, 160.0),
                ra.Vector2{ x: screen_width::f32 / 4.0 * 3.0 - 20.0, y: 230.0 },
                ra.Vector2{ x: screen_width::f32 / 4.0 * 3.0 + 20.0, y: 230.0 },
                ra.DARKBLUE
            );

            # polygon shapes and lines
            ra.draw_poly(ra.Vector2{ x: screen_width::f32 / 4.0 * 3.0, y: 330.0 }, 6, 80::f32, rotation, ra.BROWN);
            ra.draw_poly_lines(ra.Vector2{ x: screen_width::f32 / 4.0 * 3.0, y: 330.0 }, 6, 90::f32, rotation, ra.BROWN);
            ra.draw_poly_lines_ex(ra.Vector2{ x: screen_width::f32 / 4.0 * 3.0, y: 330.0 }, 6, 85::f32, rotation, 6::f32, ra.BEIGE);

            # note: we draw all lines based shapes together to optimize internal drawing,
            # this way, all lines are rendered in a single draw pass
            ra.draw_line(18, 42, screen_width - 18, 42, ra.BLACK);

            ra.logo(screen_width - 160, screen_height - 80, 1.0);
        ra.end_drawing();
    }

    # de-initialization
    ra.close_window(); # close window and opengl context

    ret 0;
}

