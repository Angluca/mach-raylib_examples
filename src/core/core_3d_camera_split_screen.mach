use std.runtime;
use raylib.ra;

# grid data
val count: f32 = 5.0;
val spacing: f32 = 4.0;

# draw the shared world scene from one view camera
# ---
# camera1: player one camera, a red cube marks its position
# camera2: player two camera, a blue cube marks its position
# view: the camera the scene is rendered with
fun draw_scene(camera1: ra.Camera, camera2: ra.Camera, view: ra.Camera) {
    ra.begin_mode3d(view);
        # draw scene: grid of cube trees on a plane to make a "world"
        ra.draw_plane(ra.Vector3{ x: 0.0, y: 0.0, z: 0.0 }, ra.Vector2{ x: 50.0, y: 50.0 }, ra.BEIGE);

        var x: f32 = -count * spacing;
        for (x <= count * spacing) {
            var z: f32 = -count * spacing;
            for (z <= count * spacing) {
                ra.draw_cube(ra.Vector3{ x: x, y: 1.5, z: z }, 1.0, 1.0, 1.0, ra.LIME);
                ra.draw_cube(ra.Vector3{ x: x, y: 0.5, z: z }, 0.25, 1.0, 0.25, ra.BROWN);
                z = z + spacing;
            }
            x = x + spacing;
        }

        # draw a cube at each player's position
        ra.draw_cube(camera1.position, 1.0, 1.0, 1.0, ra.RED);
        ra.draw_cube(camera2.position, 1.0, 1.0, 1.0, ra.BLUE);
    ra.end_mode3d();
}

# entrypoint of the 3d camera split screen example
#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    # initialization
    val screen_width: i32 = 800;
    val screen_height: i32 = 450;
    ra.init_window(screen_width, screen_height, "raylib [core] example - 3d camera split screen");

    # setup player 1 camera and screen (var zero-initializes every field, like { 0 })
    var camera_player1: ra.Camera;
    camera_player1.fovy = 45.0;
    camera_player1.up.y = 1.0;
    camera_player1.target.y = 1.0;
    camera_player1.position.z = -3.0;
    camera_player1.position.y = 1.0;
    val screen_player1: ra.RenderTexture = ra.load_render_texture(screen_width / 2, screen_height);

    # setup player two camera and screen
    var camera_player2: ra.Camera;
    camera_player2.fovy = 45.0;
    camera_player2.up.y = 1.0;
    camera_player2.target.y = 3.0;
    camera_player2.position.x = -3.0;
    camera_player2.position.y = 3.0;
    val screen_player2: ra.RenderTexture = ra.load_render_texture(screen_width / 2, screen_height);

    # build a flipped rectangle the size of the split view to use for drawing later
    val split_screen_rect: ra.Rectangle = ra.Rectangle{
        x: 0.0,
        y: 0.0,
        width: screen_player1.texture.width::f32,
        height: (-screen_player1.texture.height)::f32
    };

    ra.set_target_fps(60); # set our game to run at 60 frames-per-second

    # main game loop
    for (!ra.window_should_close()) {
        # update

        # move things at 10 world units per second, regardless of the actual fps
        val move_speed: f32 = 10.0;
        val offset_this_frame: f32 = move_speed * ra.get_frame_time();

        # move player1 forward and backwards (no turning)
        if (ra.is_key_down(ra.KEY_W)) {
            camera_player1.position.z = camera_player1.position.z + offset_this_frame;
            camera_player1.target.z = camera_player1.target.z + offset_this_frame;
        } or (ra.is_key_down(ra.KEY_S)) {
            camera_player1.position.z = camera_player1.position.z - offset_this_frame;
            camera_player1.target.z = camera_player1.target.z - offset_this_frame;
        }

        if (ra.is_key_down(ra.KEY_A)) {
            camera_player1.position.x = camera_player1.position.x + offset_this_frame;
            camera_player1.target.x = camera_player1.target.x + offset_this_frame;
        } or (ra.is_key_down(ra.KEY_D)) {
            camera_player1.position.x = camera_player1.position.x - offset_this_frame;
            camera_player1.target.x = camera_player1.target.x - offset_this_frame;
        }

        # move player2 forward and backwards (no turning)
        if (ra.is_key_down(ra.KEY_LEFT)) {
            camera_player2.position.z = camera_player2.position.z - offset_this_frame;
            camera_player2.target.z = camera_player2.target.z - offset_this_frame;
        } or (ra.is_key_down(ra.KEY_RIGHT)) {
            camera_player2.position.z = camera_player2.position.z + offset_this_frame;
            camera_player2.target.z = camera_player2.target.z + offset_this_frame;
        }

        if (ra.is_key_down(ra.KEY_UP)) {
            camera_player2.position.x = camera_player2.position.x + offset_this_frame;
            camera_player2.target.x = camera_player2.target.x + offset_this_frame;
        } or (ra.is_key_down(ra.KEY_DOWN)) {
            camera_player2.position.x = camera_player2.position.x - offset_this_frame;
            camera_player2.target.x = camera_player2.target.x - offset_this_frame;
        }

        # draw

        # draw player1 view to the render texture
        ra.begin_texture_mode(screen_player1);
            ra.clear_background(ra.SKYBLUE);
            draw_scene(camera_player1, camera_player2, camera_player1);
            ra.draw_rectangle(0, 0, ra.get_screen_width() / 2, 40, ra.fade(ra.RAYWHITE, 0.8));
            ra.draw_text("PLAYER1: W/A/S/D to move", 10, 10, 20, ra.MAROON);
        ra.end_texture_mode();

        # draw player2 view to the render texture
        ra.begin_texture_mode(screen_player2);
            ra.clear_background(ra.SKYBLUE);
            draw_scene(camera_player1, camera_player2, camera_player2);
            ra.draw_rectangle(0, 0, ra.get_screen_width() / 2, 40, ra.fade(ra.RAYWHITE, 0.8));
            ra.draw_text("PLAYER2: UP/DOWN/LEFT/RIGHT", 10, 10, 20, ra.DARKBLUE);
        ra.end_texture_mode();

        # draw both views render textures to the screen side by side
        ra.begin_drawing();
            ra.clear_background(ra.BLACK);
            ra.draw_texture_rec(screen_player1.texture, split_screen_rect, ra.Vector2{ x: 0.0, y: 0.0 }, ra.WHITE);
            ra.draw_texture_rec(screen_player2.texture, split_screen_rect, ra.Vector2{ x: screen_width::f32 / 2.0, y: 0.0 }, ra.WHITE);
            ra.draw_rectangle(ra.get_screen_width() / 2 - 2, 0, 4, ra.get_screen_height(), ra.LIGHTGRAY);
            ra.logo(screen_width - 160, screen_height - 80, 1.0);
        ra.end_drawing();
    }

    # de-initialization
    ra.unload_render_texture(screen_player1); # unload render texture
    ra.unload_render_texture(screen_player2); # unload render texture
    ra.close_window(); # close window and opengl context

    ret 0;
}

